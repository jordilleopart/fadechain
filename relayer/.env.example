# Relayer Environment Variables
# Copy to .env and fill in values

# Sepolia RPC
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Private key of the relayer account (this account pays gas)
# NEVER commit this. Fund this account with Sepolia ETH.
RELAYER_PRIVATE_KEY=

# Address of the deployed ZKTimeDecayVoting contract
VOTING_CONTRACT_ADDRESS=

# Port for the relayer server
RELAYER_PORT=3001
